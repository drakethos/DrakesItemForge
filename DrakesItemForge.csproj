<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == '' OR '$(SolutionDir)' == '*Undefined*'">$(MSBuildProjectDirectory)\..\</SolutionDir>
  </PropertyGroup>
  <Import Project="packages\JotunnLib.2.26.1\build\JotunnLib.props" Condition="Exists('packages\JotunnLib.2.26.1\build\JotunnLib.props')" />
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1111111-1111-4111-8111-111111111103}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup>
    <NewtonsoftJsonDll>$(MSBuildProjectDirectory)\packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll</NewtonsoftJsonDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiframework">
      <HintPath>$(PublicizedAssembliesPath)\gui_framework_publicized.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(PublicizedAssembliesPath)\assembly_valheim_publicized.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(PublicizedAssembliesPath)\assembly_utils_publicized.dll</HintPath>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>packages\JotunnLib.2.26.1\lib\net462\Jotunn.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(CorlibPath)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Commands\ItemForgeCommands.cs" />
    <Compile Include="Generator\CategoryScanner.cs" />
    <Compile Include="Generator\ItemForgeGenerator.cs" />
    <Compile Include="Generator\TemplateWriter.cs" />
    <Compile Include="ItemForgeConfig.cs" />
    <Compile Include="ItemForgePlugin.cs" />
    <Compile Include="Localization\ItemForgeLocalization.cs" />
    <Compile Include="Patches\ObjectDbPatches.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Runtime\BuiltItem.cs" />
    <Compile Include="Runtime\DefaultItems.cs" />
    <Compile Include="Runtime\FailureLogWriter.cs" />
    <Compile Include="Runtime\FieldApplicators\ArmorApplicator.cs" />
    <Compile Include="Runtime\FieldApplicators\DamageTypeMapper.cs" />
    <Compile Include="Runtime\FieldApplicators\FoodApplicator.cs" />
    <Compile Include="Runtime\FieldApplicators\GeneralApplicator.cs" />
    <Compile Include="Runtime\FieldApplicators\ToolApplicator.cs" />
    <Compile Include="Runtime\FieldApplicators\WeaponApplicator.cs" />
    <Compile Include="Runtime\ItemBuilder.cs" />
    <Compile Include="Runtime\ItemForgePaths.cs" />
    <Compile Include="Runtime\ItemForgeRuntime.cs" />
    <Compile Include="Runtime\ItemLoader.cs" />
    <Compile Include="Runtime\ItemRegistrar.cs" />
    <Compile Include="Runtime\ItemValidator.cs" />
    <Compile Include="Runtime\ReferenceCache.cs" />
    <Compile Include="Runtime\ValidationFailure.cs" />
    <Compile Include="Schema\ItemDefinitionDto.cs" />
    <Compile Include="Schema\StationAliases.cs" />
    <Compile Include="Schema\TemplateRegistry.cs" />
    <Compile Include="Util\Levenshtein.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <None Include="packages.config" />
    <None Include="Examples\stormfang.json" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CopyNewtonsoftJsonToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(NewtonsoftJsonDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(NewtonsoftJsonDll)')" />
  </Target>
  <Target Name="CopyNewtonsoftJsonToR2Profile" AfterTargets="CopyToR2Profile" Condition="'$(R2ModDeployPath)' != '' and Exists('$(NewtonsoftJsonDll)')">
    <Copy SourceFiles="$(NewtonsoftJsonDll)" DestinationFolder="$(R2ModDeployPath)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Deployed Newtonsoft.Json.dll -&gt; $(R2ModDeployPath)" />
  </Target>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('packages\JotunnLib.2.26.1\build\JotunnLib.props')" Text="Restore NuGet packages." />
    <Error Condition="!Exists('packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll')" Text="Restore NuGet packages (Newtonsoft.Json)." />
  </Target>
  <Target Name="PackageMod" AfterTargets="Build;CopyNewtonsoftJsonToOutput" DependsOnTargets="WriteThunderstoreManifest">
    <MakeDir Directories="$(ThunderstoreFolder)" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(ThunderstoreFolder)" />
    <Copy SourceFiles="$(NewtonsoftJsonDll)" DestinationFolder="$(ThunderstoreFolder)" Condition="Exists('$(NewtonsoftJsonDll)')" />
    <Copy SourceFiles="$(TargetDir)README.md" DestinationFiles="$(ThunderstoreFolder)\README.md" />
    <Copy SourceFiles="$(TargetDir)icon.png" DestinationFiles="$(ThunderstoreFolder)\icon.png" />
    <Copy SourceFiles="$(TargetDir)CHANGELOG.md" DestinationFiles="$(ThunderstoreFolder)\CHANGELOG.md" />
    <Exec Command="powershell -Command Compress-Archive -Path '$(ThunderstoreFolder)\*' -DestinationPath '$(ZipOutput)' -Force" Condition="'$(CI_SKIP_POST_BUILD)' == ''" />
  </Target>
  <ItemGroup>
    <Content Include="CHANGELOG.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
